@model ContactInfo
@{
    ViewData["Title"] = "İletişim Bilgisi Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<form method="post">
    <input type="hidden" asp-for="ContactInfoId" />
    <div class="form-group">
        <label>Adres Bilgisi</label>
        <input type="text" class="form-control" asp-for="Address" />
        <br />
        <label>Telefon Numarası</label>
        <input type="text" class="form-control" asp-for="PhoneNumber" />
        <br />
        <label>E mail</label>
        <input type="text" class="form-control" asp-for="Email" />
        <br />
        <label>Harita Url</label>
        <input type="text" class="form-control" asp-for="MapUrl" />

    </div>

    <button class="btn btn-primary">Güncelle</button>
</form>


