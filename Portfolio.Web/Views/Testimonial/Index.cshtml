@model List<Testimonial>
@{
    ViewData["Title"] = "Referanslar";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}
@{
    int count = 0;
}

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>İsim</th>
        <th>Ünvan</th>
        <th>Fotoğraf Url</th>
        <th>Yorum</th>
        <th>Puan</th>
        <th>İşlemler</th>
    </tr>

    @foreach(var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@item.Name</td>
            <td>@item.Title</td>
            <td>@item.ImageUrl</td>
            <td>@item.Comment</td>
            <td>@item.Review</td>
            <td>
                <a href="/Testimonial/DeleteTestimonial/@item.TestimonialId" class="btn btn-outline-danger">Sil</a>
                <a href="/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>

<a href="/Testimonial/CreateTestimonial" class="btn btn-outline-primary">Yeni Referans Ekle</a>
