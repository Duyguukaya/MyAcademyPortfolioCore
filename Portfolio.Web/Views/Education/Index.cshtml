@model List<Education>
@{
    ViewData["Title"] = "Eğitimler";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

@{
    int count = 0;
}

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>Okul İsmi</th>
        <th>Bölümü</th>
        <th>Başlangıç Yılı</th>
        <th>Bitiş Yılı</th>
        <th>Açıklama</th>
        <th>İşlemler</th>
    </tr>
    @foreach(var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@item.SchoolName</td>
            <td>@item.Departmant</td>
            <td>@item.StartYear</td>
            <td>@item.EndYear</td>
            <td>@item.Description</td>
            <td>
                <a href="/Education/DeleteEducation/@item.EducationId" class="btn btn-outline-danger">Sil</a>
                <a href="/Education/UpdateEdication/@item.EducationId" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>

<a href="/Education/CreateEducation" class="btn btn-outline-primary">Yeni Eğitim Ekle</a>

