@model List<About>
@{
    ViewData["Title"] = "Hakkımda";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

@{
    int count = 0;
}

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>Fotoğraf Url</th>
        <th>Başlık</th>
        <th>Açıklama</th>
        <th>Doğum Tarihi</th>
        <th>Web Sitesi</th>
        <th>Telefon Numarası</th>
        <th>Şehir</th>
        <th>Derece</th>
        <th>E mail</th>
        <th>Freelance Çalışmaya Uygunluk</th>
        <th>İşlemler</th>
    </tr>
    @foreach(var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@item.ImageUrl</td>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>@item.BirthDate</td>
            <td>@item.WebSite</td>
            <td>@item.PhoneNumber</td>
            <td>@item.City</td>
            <td>@item.Graduation</td>
            <td>@item.Email</td>
            <td>@item.IsAvailable</td>
            <td><a href="/About/UpdateAbout/@item.AboutId" class="btn btn-outline-success">Güncelle</a></td>
        </tr>
    }
</table>

