@model List<About>
@*
    _Default About Component
*@

<section id="about" class="about section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Hakkımda</h2>
        <p>Merhaba! Ben bilgisayar mühendisliği öğrencisiyim. .NET teknolojileriyle yazılım geliştirmeyi seviyor, her gün yeni şeyler öğrenmeye çalışıyorum. Bu sitede de öğrendiklerimi ve projelerimi paylaşmayı hedefliyorum.</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        @foreach(var item in Model){
        <div class="row gy-4 justify-content-center">
            <div class="col-lg-4">
                <img src="@item.ImageUrl" class="img-fluid" alt="">
            </div>
            <div class="col-lg-8 content">
                <h2>@item.Title</h2>
                <div class="row">
                    <div class="col-lg-6">
                        <ul>
                                <li><i class="bi bi-chevron-right"></i> <strong>Doğum Tarihi:</strong> <span>@item.BirthDate.ToString("dd.MM.yyyy")</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>Website:</strong> <span>@item.WebSite</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Telefon No:</strong> <span>@item.PhoneNumber</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Şehir:</strong> <span>@item.City</span></li>
                        </ul>
                    </div>
                    <div class="col-lg-6">
                        <ul>
                                <li>
                                    <i class="bi bi-chevron-right"></i> <strong>Yaş:</strong> <span>
                                        @{
                                            var today = DateTime.Today;
                                            var age = today.Year - item.BirthDate.Year;
                                            if (item.BirthDate.Date > today.AddYears(-age)) age--;
                                            @age
                                        }
                                    </span>
                                </li>
                            <li><i class="bi bi-chevron-right"></i> <strong>Derece:</strong> <span>@item.Graduation</span></li>
                            <li><i class="bi bi-chevron-right"></i> <strong>E-mail:</strong> <span>@item.Email</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>Freelance Çalışmaya Uygulnluk:</strong> @if (item.IsAvailable == true)
                                        {
                                        <span>uygun</span>
                                    }
                                    else
                                    {
                                        <span>uygun değil</span>
                                    }
                                </li>
                            </ul>
                    </div>
                </div>
                <p class="py-3">
                 @item.Description
                </p>
            </div>
        </div>
        }
    </div>

</section>