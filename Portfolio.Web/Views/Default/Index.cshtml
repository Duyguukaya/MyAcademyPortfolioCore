
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<!-- Hero Section -->
<section id="hero" class="hero section">

    <img src="~/img/arkaplan.jpg" alt="" data-aos="fade-in">

    <div class="container text-center" data-aos="zoom-out" data-aos-delay="100">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 style="color:white">Duygu Kaya</h2>
                <p style="color:white">Bilgisayar Mühendisliği Öğrencisi</p>
                <a style="color:white" href="#" class="btn-get-started">Hakkımda</a>
            </div>
        </div>
    </div>

</section><!-- /Hero Section -->
<!-- About Section -->
@await Component.InvokeAsync("_DefaultAboutComponent");
<!-- /About Section -->
<!-- Resume Section -->
<section id="resume" class="resume section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Özgeçmiş</h2>
        <p>NBilgisayar mühendisliği öğrencisiyim. Yazılım geliştirmeye özellikle .NET teknolojileriyle ilgileniyorum ve yeni şeyler öğrenmekten keyif alıyorum. Üniversite hayatımda projeler üreterek deneyim kazanıyor ve kendimi sürekli geliştirmeye çalışıyorum.</p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row">

            @await Component.InvokeAsync("_DefaultEducationComponent")

            @await Component.InvokeAsync("_DefaultExperienceComponent")

           

        </div>

    </div>

</section><!-- /Resume Section -->
<!-- Skills Section -->
@await Component.InvokeAsync("_DefaultSkillComponent");
<!-- /Skills Section -->
<!-- Stats Section -->
<section id="stats" class="stats section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Facts</h2>
        <p>Necessitatibus eius consequatur ex aliquid fuga eum quidem sint consectetur velit</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="232" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Clients</p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="521" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Projects</p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="1453" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Hours Of Support</p>
                </div>
            </div><!-- End Stats Item -->

            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="32" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Workers</p>
                </div>
            </div><!-- End Stats Item -->

        </div>

    </div>

</section><!-- /Stats Section -->
