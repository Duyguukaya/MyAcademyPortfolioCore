
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<!-- Hero Section -->
<section id="hero" class="hero section">

    <img src="~/img/arkaplan.png" alt="" data-aos="fade-in">

    <div class="container text-center" data-aos="zoom-out" data-aos-delay="100">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 style="color:black">Duygu Kaya</h2>
                <p style="color:black">Bilgisayar Mühendisliği Öğrencisi</p>
                <a style="color:black" href="#" class="btn-get-started">Hakkımda</a>
            </div>
        </div>
    </div>

</section><!-- /Hero Section -->
<!-- About Section -->
@await Component.InvokeAsync("_DefaultAboutComponent");
<!-- /About Section -->
<!-- Resume Section -->
<section id="resume" class="resume section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Özgeçmiş</h2>
        <p>NBilgisayar mühendisliği öğrencisiyim. Yazılım geliştirmeye özellikle .NET teknolojileriyle ilgileniyorum ve yeni şeyler öğrenmekten keyif alıyorum. Üniversite hayatımda projeler üreterek deneyim kazanıyor ve kendimi sürekli geliştirmeye çalışıyorum.</p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row">

            @await Component.InvokeAsync("_DefaultEducationComponent")

            @await Component.InvokeAsync("_DefaultExperienceComponent")

           

        </div>

    </div>

</section><!-- /Resume Section -->
<!-- Skills Section -->
@await Component.InvokeAsync("_DefaultSkillComponent");
<!-- /Skills Section -->
<!-- Stats Section -->
@await Component.InvokeAsync("_DefaultStatsComponent");
<!-- /Stats Section -->
<!-- Testimonials Section -->
@await Component.InvokeAsync("_DefaultTestimonialsComponent");
<!-- /Testimonials Section -->
<!-- project Section -->
@await Component.InvokeAsync("_DefaultProjectComponent");
<!-- /project Section -->
<!-- Contact Section -->
@await Component.InvokeAsync("_DefaultContactComponent");
<!-- /Contact Section -->

